# Configuración del Servidor
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cenarepas_db
DB_SCHEMA=cenarepas

# Seguridad y Autenticación JWT
JWT_SECRET=cenarepas_super_secret_jwt_key_2026_masarepas
JWT_EXPIRES_IN=24h

# Correo (recuperación de contraseña). En Staging y local: CORREO_PROVEEDOR=consola
# (no envía; escribe el código en la consola). En producción (Render): brevo.
# Render gratuito bloquea el SMTP saliente: por eso se usa la API de Brevo.
CORREO_PROVEEDOR=consola
BREVO_API_KEY=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=CENAREPAS
